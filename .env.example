YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
# Must exactly match the redirect registered with Yahoo. Paste the final callback URL in CLI.
YAHOO_REDIRECT_URI=https://localhost:8765/callback
FANTASY_LEAGUE_ID=30166
FANTASY_SEASON=2026
# Optional overrides, normally discovered:
# FANTASY_LEAGUE_KEY=
# FANTASY_TEAM_KEY=
# FANTASY_DATA_DIR=/absolute/path/to/private/data
# FANTASY_PLAYER_DATA_FILE=/absolute/path/to/normalized-provider.json
FANTASY_MIN_GAMES=10
FANTASY_MIN_MINUTES=10
FANTASY_POPULATION_SIZE=200
# Optional documented schedule provider (no projections):
# BALLDONTLIE_API_KEY=
